# Only `dist` is published (see the "files" field in package.json). This file
# ensures source, stories, configs, and tooling never end up in the tarball.
src/
.storybook/
storybook-static/
*.config.ts
*.config.js
tsconfig*.json
.prettierrc*
.gitignore
.claude/
**/*.stories.tsx
**/*.test.ts
**/*.test.tsx
