{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@nucleux/utils": ["packages/utils/src/index.ts"],
      "@nucleux/hooks": ["packages/hooks/src/index.ts"],
      "@nucleux/react": ["packages/react/src/index.ts"],
      "@nucleux/*": ["packages/*/src/index.tsx"]
    }
  },
  "include": ["packages/*/src", "src/test", "vitest.config.ts", ".storybook"],
  "exclude": ["node_modules", "**/dist"]
}
