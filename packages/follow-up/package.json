{
  "name": "@nucleux/follow-up",
  "version": "0.1.1",
  "type": "module",
  "sideEffects": false,
  "description": "FollowUp — AI answer with an editable assumption chip — Nucleux agentic UI for React.",
  "keywords": ["nucleux", "react", "ui", "components", "agentic", "ai", "tailwind", "follow-up", "assumption"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
