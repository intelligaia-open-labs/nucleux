  "files": ["dist", "README.md"],
  "scripts": { "build": "tsup" },
  "peerDependencies": { "react": ">=18", "react-dom": ">=18" },
  "dependencies": { "@nucleux/utils": "workspace:*" },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "@types/react": "^18.3.18",
    "react": "^18.3.1",
    "lucide-react": "^0.469.0"
  },
  "publishConfig": { "access": "public" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelligaia-open-labs/nucleux.git",
    "directory": "packages/follow-up"
  },
  "homepage": "https://github.com/intelligaia-open-labs/nucleux#readme"
