{
  "name": "@nucleux/md3-open-input",
  "version": "0.11.2",
  "type": "module",
  "sideEffects": false,
  "description": "Material 3 Open Input \u2014 the persistent free-form composer for any natural-language ask: grows to eight lines then Expand, with a Request settings menu (Mode, Tone, Style, Improve prompt) \u2014 Nucleux agentic UI for React.",
  "keywords": [
    "nucleux",
    "react",
    "ui",
    "components",
    "agentic",
    "ai",
    "tailwind",
    "md3",
    "material",
    "md3-open-input",
    "open-input",
    "composer",
    "prompt",
    "request-settings",
    "settings",
    "tune",
    "menu",
    "expand"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@nucleux/md3-button": "workspace:*",
    "@nucleux/md3-icon-button": "workspace:*",
    "@nucleux/md3-icons": "workspace:*",
    "@nucleux/md3-loading-indicator": "workspace:*",
    "@nucleux/open-input": "workspace:*",
    "@nucleux/utils": "workspace:*",
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "@types/react": "^18.3.18",
    "react": "^18.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelligaia-open-labs/nucleux.git",
    "directory": "packages/md3-open-input"
  },
  "homepage": "https://github.com/intelligaia-open-labs/nucleux#readme"
}
