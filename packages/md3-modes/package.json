{
  "name": "@nucleux/md3-modes",
  "version": "0.11.2",
  "type": "module",
  "sideEffects": false,
  "description": "Material 3 Modes — choose how the agent approaches a request (Brainstorm, Draft, Review, Plan), as a chip in the composer or a Mode row in Request settings, switchable before sending — Nucleux agentic UI for React.",
  "keywords": [
    "nucleux",
    "react",
    "ui",
    "components",
    "agentic",
    "ai",
    "tailwind",
    "md3",
    "material",
    "md3-modes",
    "modes",
    "mode-picker",
    "prompt-scaffolds",
    "request-settings"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@nucleux/md3-agent-composer": "workspace:*",
    "@nucleux/md3-button": "workspace:*",
    "@nucleux/md3-chip": "workspace:*",
    "@nucleux/md3-icon-button": "workspace:*",
    "@nucleux/md3-menu": "workspace:*",
    "@nucleux/md3-open-input": "workspace:*",
    "@nucleux/md3-segmented-button": "workspace:*",
    "@nucleux/modes": "workspace:*",
    "@nucleux/utils": "workspace:*",
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "@types/react": "^18.3.18",
    "react": "^18.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelligaia-open-labs/nucleux.git",
    "directory": "packages/md3-modes"
  },
  "homepage": "https://github.com/intelligaia-open-labs/nucleux#readme"
}
