{
  "name": "@nucleux/voice-tone",
  "version": "0.11.2",
  "type": "module",
  "sideEffects": false,
  "description": "Voice & Tone — say how the reply should sound (named presets, a rules list, a sample line), as a Tone chip or a Tone row in Request settings, never editing the prompt — Nucleux agentic UI for React.",
  "keywords": [
    "nucleux",
    "react",
    "ui",
    "components",
    "agentic",
    "ai",
    "tailwind",
    "voice-tone",
    "tone",
    "prompt-scaffold",
    "request-settings"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@nucleux/button": "workspace:*",
    "@nucleux/checkbox": "workspace:*",
    "@nucleux/input": "workspace:*",
    "@nucleux/open-input": "workspace:*",
    "@nucleux/popover": "workspace:*",
    "@nucleux/slider": "workspace:*",
    "@nucleux/utils": "workspace:*",
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "@types/react": "^18.3.18",
    "react": "^18.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelligaia-open-labs/nucleux.git",
    "directory": "packages/voice-tone"
  },
  "homepage": "https://github.com/intelligaia-open-labs/nucleux#readme"
}
