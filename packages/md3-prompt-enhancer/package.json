{
  "name": "@nucleux/md3-prompt-enhancer",
  "version": "0.11.3",
  "type": "module",
  "sideEffects": false,
  "description": "Material 3 Prompt Enhancer — proposes a clearer version of the request you wrote, every addition marked and explained; starts from the wand or the Improve prompt row in Request settings — Nucleux agentic UI for React.",
  "keywords": [
    "nucleux",
    "react",
    "ui",
    "components",
    "agentic",
    "ai",
    "tailwind",
    "md3",
    "material",
    "md3-prompt-enhancer",
    "prompt-enhancer",
    "prompt",
    "enhance",
    "prompt-scaffold",
    "request-settings"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@nucleux/md3-agent-composer": "workspace:*",
