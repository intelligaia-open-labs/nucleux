    "@nucleux/md3-card": "workspace:*",
    "@nucleux/md3-checkbox": "workspace:*",
    "@nucleux/md3-open-input": "workspace:*",
    "@nucleux/md3-switch": "workspace:*",
    "@nucleux/prompt-enhancer": "workspace:*",
    "@nucleux/utils": "workspace:*",
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "@nucleux/md3-icon-button": "workspace:*",
    "@types/react": "^18.3.18",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelligaia-open-labs/nucleux.git",
