{
  "name": "@nucleux/prompt-enhancer",
  "version": "0.11.2",
  "type": "module",
  "sideEffects": false,
  "description": "Prompt Enhancer — a magic-wand action that rewrites a short ask into a precise one, shown as a reviewable diff; starts from the wand or the Improve prompt row in Request settings — Nucleux agentic UI for React.",
  "keywords": [
    "nucleux",
    "react",
    "ui",
    "components",
    "agentic",
    "ai",
    "tailwind",
    "prompt-enhancer",
    "prompt",
    "enhance",
    "prompt-scaffold",
    "request-settings"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@nucleux/button": "workspace:*",
    "@nucleux/card": "workspace:*",
    "@nucleux/checkbox": "workspace:*",
    "@nucleux/input-group": "workspace:*",
    "@nucleux/open-input": "workspace:*",
    "@nucleux/spinner": "workspace:*",
    "@nucleux/switch": "workspace:*",
    "@nucleux/utils": "workspace:*",
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "@types/react": "^18.3.18",
    "react": "^18.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelligaia-open-labs/nucleux.git",
    "directory": "packages/prompt-enhancer"
  },
  "homepage": "https://github.com/intelligaia-open-labs/nucleux#readme"
}
